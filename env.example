GITHUB_TOKEN=your_token
GITHUB_USERNAME=your_username

# MongoDB connection string for the portfolio API server
MONGODB_URI=mongodb://localhost:27017/portfolio

# URL of the Express API server (used by the React frontend)
# Leave blank to use static portfolio.js data (no backend required)
REACT_APP_API_URL=http://localhost:5000


after doing all changes,
hit run deploy to generate build folder and publish it to github
run git add . -f to save all files to commit
git commit -m "" to commit
